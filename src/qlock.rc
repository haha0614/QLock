// QLock 资源：图标沿用 0.3.0 的蓝色兔子
#include <windows.h>
#include "resource.h"

IDI_APP ICON "QLock.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "QLock"
            VALUE "FileDescription", "QLock lock screen"
            VALUE "FileVersion", "0.4.0.0"
            VALUE "InternalName", "QLock"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "QLock.exe"
            VALUE "ProductName", "QLock"
            VALUE "ProductVersion", "0.4.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4B0
    END
END
